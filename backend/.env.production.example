# ==============================================================================
# ReachInbox Backend - Production Environment Template (Render Deployment)
# ==============================================================================

NODE_ENV=production
PORT=10000

# 1. Frontend URL (Vercel Production Domain)
FRONTEND_URL=https://your-reachinbox-app.vercel.app

# 2. Database (Render PostgreSQL Internal or External Connection String)
# Example: postgresql://reachinbox_user:secret@dpg-xxxx-a.oregon-postgres.render.com/reachinbox?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# 3. Redis (Render Redis Internal or External Connection String)
# Supports rediss:// for TLS encrypted connections
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# 4. Elasticsearch (Optional - System will automatically fall back to Postgres if omitted)
ELASTICSEARCH_URL=

# 5. Security & Tokens
# Generate a strong 64-character random string (e.g. openssl rand -hex 32)
JWT_SECRET=production-reachinbox-super-secure-jwt-secret-key-32-chars-min

# 6. Worker & Scheduling Configuration
WORKER_CONCURRENCY=10
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# 7. Google OAuth 2.0 (Configure Authorized Redirect URIs in Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=https://your-reachinbox-backend.onrender.com/auth/google/callback

# 8. Ethereal SMTP / Custom SMTP (For outbound email delivery testing)
ETHEREAL_USER=
ETHEREAL_PASSWORD=
