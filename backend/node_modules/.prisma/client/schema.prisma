generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id               String   @id @default(uuid())
  googleId         String?  @unique
  name             String
  email            String   @unique
  avatar           String?
  slackAccessToken String?
  createdAt        DateTime @default(now())
  emails           Email[]
}

model Sender {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  etherealUser String
  etherealPass String
  createdAt    DateTime @default(now())
  emails       Email[]
}

model Email {
  id            String      @id @default(uuid())
  userId        String
  senderId      String
  recipient     String
  subject       String
  bodyHtml      String
  scheduledAt   DateTime
  sentAt        DateTime?
  status        EmailStatus @default(SCHEDULED)
  failureReason String?
  bullJobId     String?     @unique
  isStarred     Boolean     @default(false)
  attachments   Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id])
  sender        Sender      @relation(fields: [senderId], references: [id])

  @@index([userId, status, scheduledAt])
  @@index([senderId, scheduledAt])
}
